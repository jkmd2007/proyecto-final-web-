# para ejecutar sin Docker expórtalas en tu terminal antes de `python run.py`.
# Base de datos: por defecto SQLite en instance/riul.db
# DATABASE_URL=mysql+pymysql://Riul_user:Riul_password@localhost:3307/Riul_db?charset=utf8mb4
